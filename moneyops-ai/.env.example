# Copy to .env and fill in. Never commit .env.
# ---- Live odds (required for analysis) ------------------------------------
# Get a key at https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=your-odds-api-key-here
ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h,spreads,totals
# Optional: restrict to specific books (overrides regions), e.g. draftkings,fanduel,betmgm
ODDS_API_BOOKMAKERS=
# Credit guard: max credits one analysis run may spend, and a reserve never touched
MAX_CREDITS_PER_RUN=60
MIN_CREDITS_RESERVE=25
ENABLED_SPORTS=NFL,NCAAF,NBA,NCAAB,NCAAW,WNBA,MLB,NHL,EPL,MLS,UCL,LALIGA,BUNDESLIGA,SERIEA,LIGUE1,MMA
SCAN_TENNIS=false
SCAN_OTHER_SPORTS=false
INCLUDE_PLAYER_PROPS=false
PROP_MARKETS=player_points,player_rebounds,player_assists
USE_ODDS_API_SCORES=false
# ---- AllSportsAPI (optional): 2nd schedule/result source, extra books, probabilities
# https://allsportsapi.com  (profile: https://github.com/api-evangelist/all-sports-api)
ALLSPORTS_API_KEY=
ALLSPORTS_TIMEZONE=UTC
ALLSPORTS_USE_ODDS=true
ALLSPORTS_USE_PROBABILITIES=true
ALLSPORTS_MAX_REQUESTS_PER_RUN=80
# Add-on sports with undocumented paths, e.g. NHL:hockey,MLB:baseball
ALLSPORTS_PATH_OVERRIDES=
# ---- sportsipy (optional): player game logs for props from sports-reference.com
# Unmaintained library; scraper. Keep the rate low (hard cap 19/min).
SPORTSIPY_ENABLED=false
SPORTSIPY_MAX_REQUESTS_PER_MINUTE=15
SPORTSIPY_GAMES_PER_TEAM=15
SPORTSIPY_MAX_REQUESTS_PER_RUN=150
# ---- Independent schedules / results / history / injuries -----------------
ESPN_ENABLED=true
# ---- Risk (paper trading) --------------------------------------------------
STARTING_BANKROLL=25
MAX_STAKE_PCT=0.01
PARLAY_MAX_STAKE_PCT=0.005
MAX_OPEN_EXPOSURE_PCT=0.05
MAX_DRAWDOWN_HALT_PCT=0.25
KELLY_FRACTION=0.25
MIN_EV=0.02
MIN_BOOKS=3
# ---- Runtime ---------------------------------------------------------------
TIMEZONE=America/New_York
REFRESH_INTERVAL_MINUTES=60
DATABASE_URL=sqlite:///moneyops.db
